NODE_ENV=development
PORT=5001
AI_SERVICE_URL=http://localhost:5001

BACKEND_SERVICE_URL=http://localhost:5000


# Primary provider
AI_PRIMARY_PROVIDER=sarvam

# Fallback provider
AI_FALLBACK_PROVIDER=groq

SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Backend-to-AI service authentication
AI_SERVICE_SECRET=replace_with_the_same_long_random_secret_as_backend

AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=1