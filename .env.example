# ========================================================
# Wealthra™ Monorepo Environment Configuration Example
# All rights to this project are owned by DEVRATOR.
# ========================================================

# --------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vite React Client)
# --------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_APP_NAME="Wealthra™"
VITE_APP_TAGLINE="Financial Operations & Invoicing Platform"
VITE_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
VITE_RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
VITE_ENABLE_AI_VOICE=true

# --------------------------------------------------------
# 2. BACKEND API CONFIGURATION (Express.js Core)
# --------------------------------------------------------
PORT=5000
NODE_ENV=development
API_PREFIX=/api
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database Connection (Neon PostgreSQL 18)
DATABASE_URL="postgresql://username:password@ep-your-cluster.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication & Session
JWT_SECRET="your_secure_random_jwt_secret_here_min_32_chars"
JWT_EXPIRES_IN="7d"
SESSION_COOKIE_NAME="wealthra_session"
SESSION_DURATION_DAYS=7

# Internal Service Secret for AI Service Communication
INTERNAL_SERVICE_SECRET="your_secure_internal_service_secret_here"
AI_SERVICE_URL="http://localhost:5001"

# Google OAuth 2.0 Backend Verification
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --------------------------------------------------------
# 3. MULTILINGUAL AI & SPEECH ENGINE (Sarvam + Gemini)
# --------------------------------------------------------
AI_PROVIDER="auto"
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-2.0-flash"
SARVAM_API_KEY="your_sarvam_ai_api_key_here"

# --------------------------------------------------------
# 4. PAYMENT GATEWAYS (Sandbox Integration)
# --------------------------------------------------------
# Razorpay Domestic Gateway (UPI, Cards, NetBanking)
RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# PayPal Global Gateway
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id"

# --------------------------------------------------------
# 5. EMAIL & NOTIFICATIONS
# --------------------------------------------------------
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
EMAIL_FROM="Wealthra <noreply@wealthra.com>"
