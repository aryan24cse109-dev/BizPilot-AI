
# Application
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_ENCODED_PASSWORD@localhost:5432/bizpilot_ai?schema=public"

# Frontend
FRONTEND_URL=http://localhost:5173

# AI Service
AI_SERVICE_URL=http://localhost:6000
INTERNAL_SERVICE_SECRET=replace_with_a_long_random_secret

# Google Authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=replace_with_a_long_random_secret
SESSION_COOKIE_NAME=bizpilot_session
SESSION_DURATION_DAYS=7

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=
