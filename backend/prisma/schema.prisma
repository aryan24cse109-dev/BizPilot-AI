generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------
// ENUMS
// -----------------------------------------------------

enum AccountCategory {
  BUSINESS
  CLIENT
}

enum BusinessType {
  SMALL_BUSINESS
  FREELANCER
  STARTUP
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ConnectionStatus {
  PENDING
  ACTIVE
  REJECTED
  BLOCKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum NotificationType {
  INVOICE_SENT
  INVOICE_VIEWED
  INVOICE_PAID
  INVOICE_OVERDUE
  PAYMENT_RECEIVED
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  SYSTEM_ALERT
}

// -----------------------------------------------------
// USER AND PROFILE MODELS
// -----------------------------------------------------

model User {
  id       String @id @default(uuid()) @db.Uuid
  email    String @unique @db.VarChar(255)
  username String @unique @db.VarChar(50)
  fullName String @db.VarChar(150)

  // Authentication fields
  googleSubject       String?   @unique @db.VarChar(255)
  passwordHash        String?
  emailVerifiedAt     DateTime? @db.Timestamptz(3)
  onboardingCompleted Boolean   @default(false)

  sessions AuthSession[]

  accountCategory AccountCategory
  status          AccountStatus   @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  businessProfile BusinessProfile?
  clientProfile   ClientProfile?

  businessConnections Connection[] @relation("BusinessConnections")
  clientConnections   Connection[] @relation("ClientConnections")

  sentInvitations     Invitation[] @relation("InvitationSender")
  acceptedInvitations Invitation[] @relation("InvitationAccepter")

  ownedInvoices  Invoice[] @relation("InvoiceBusiness")
  clientInvoices Invoice[] @relation("InvoiceClient")

  businessPayments Payment[] @relation("PaymentBusiness")
  clientPayments   Payment[] @relation("PaymentClient")

  notifications Notification[]

  actedAuditLogs AuditLog[] @relation("AuditActor")
  ownedAuditLogs AuditLog[] @relation("AuditOwner")

  @@index([accountCategory, status])
  @@map("users")
}

model BusinessProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  businessType BusinessType
  businessName String       @db.VarChar(200)
  legalName    String?      @db.VarChar(200)

  description   String? @db.Text
  businessEmail String? @db.VarChar(255)
  phone         String? @db.VarChar(30)
  website       String? @db.VarChar(255)

  gstin    String? @db.VarChar(20)
  country  String  @default("India") @db.VarChar(100)
  currency String  @default("INR") @db.VarChar(3)

  addressLine1 String? @db.VarChar(255)
  addressLine2 String? @db.VarChar(255)
  city         String? @db.VarChar(100)
  state        String? @db.VarChar(100)
  postalCode   String? @db.VarChar(20)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("business_profiles")
}

model ClientProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  phone          String? @db.VarChar(30)
  billingAddress String? @db.Text
  city           String? @db.VarChar(100)
  state          String? @db.VarChar(100)
  postalCode     String? @db.VarChar(20)
  country        String  @default("India") @db.VarChar(100)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("client_profiles")
}

model AuthSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  tokenHash String @unique @db.VarChar(64)

  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  ipAddress String? @db.VarChar(50)
  userAgent String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

// -----------------------------------------------------
// BUSINESS - CLIENT CONNECTIONS
// -----------------------------------------------------

model Connection {
  id String @id @default(uuid()) @db.Uuid

  businessUserId String @db.Uuid
  clientUserId   String @db.Uuid

  status ConnectionStatus @default(PENDING)

  requestedAt DateTime  @default(now()) @db.Timestamptz(3)
  acceptedAt  DateTime? @db.Timestamptz(3)
  rejectedAt  DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  businessUser User @relation("BusinessConnections", fields: [businessUserId], references: [id], onDelete: Restrict)
  clientUser   User @relation("ClientConnections", fields: [clientUserId], references: [id], onDelete: Restrict)

  @@unique([businessUserId, clientUserId])
  @@index([businessUserId, status])
  @@index([clientUserId, status])
  @@map("connections")
}

// -----------------------------------------------------
// CLIENT INVITATIONS
// -----------------------------------------------------

model Invitation {
  id String @id @default(uuid()) @db.Uuid

  businessUserId String @db.Uuid
  email          String @db.VarChar(255)

  // Store only the hash of the invitation token.
  tokenHash String @unique @db.VarChar(255)

  status InvitationStatus @default(PENDING)

  expiresAt  DateTime  @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  acceptedByUserId String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  businessUser   User  @relation("InvitationSender", fields: [businessUserId], references: [id], onDelete: Restrict)
  acceptedByUser User? @relation("InvitationAccepter", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@index([businessUserId, status])
  @@index([email, status])
  @@index([expiresAt, status])
  @@map("invitations")
}

// -----------------------------------------------------
// INVOICES
// -----------------------------------------------------

model Invoice {
  id String @id @default(uuid()) @db.Uuid

  // The business account that owns this invoice.
  businessUserId String @db.Uuid

  // Optional because an invoice can be created before
  // the invited client registers.
  clientUserId String? @db.Uuid

  invoiceNumber String @db.VarChar(50)

  clientName  String @db.VarChar(150)
  clientEmail String @db.VarChar(255)

  currency String @default("INR") @db.VarChar(3)

  issueDate DateTime  @default(now()) @db.Timestamptz(3)
  dueDate   DateTime? @db.Timestamptz(3)

  status InvoiceStatus @default(DRAFT)

  subtotal       Decimal @default(0) @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal @default(0) @db.Decimal(18, 2)

  amountPaid Decimal @default(0) @db.Decimal(18, 2)
  balanceDue Decimal @default(0) @db.Decimal(18, 2)

  notes String? @db.Text
  terms String? @db.Text

  sentAt      DateTime? @db.Timestamptz(3)
  viewedAt    DateTime? @db.Timestamptz(3)
  paidAt      DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  businessUser User  @relation("InvoiceBusiness", fields: [businessUserId], references: [id], onDelete: Restrict)
  clientUser   User? @relation("InvoiceClient", fields: [clientUserId], references: [id], onDelete: Restrict)

  items    InvoiceItem[]
  payments Payment[]

  @@unique([businessUserId, invoiceNumber])
  @@index([businessUserId, status, createdAt])
  @@index([clientUserId, status])
  @@index([clientEmail])
  @@index([dueDate, status])
  @@map("invoices")
}

model InvoiceItem {
  id        String @id @default(uuid()) @db.Uuid
  invoiceId String @db.Uuid

  description String @db.VarChar(500)

  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(18, 2)

  taxRate Decimal @default(0) @db.Decimal(7, 4)

  lineSubtotal Decimal @db.Decimal(18, 2)
  lineTax      Decimal @default(0) @db.Decimal(18, 2)
  lineTotal    Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// -----------------------------------------------------
// PAYMENTS
// -----------------------------------------------------

model Payment {
  id String @id @default(uuid()) @db.Uuid

  invoiceId      String  @db.Uuid
  businessUserId String  @db.Uuid
  clientUserId   String? @db.Uuid

  provider PaymentProvider @default(RAZORPAY)
  status   PaymentStatus   @default(INITIATED)

  amount   Decimal @db.Decimal(18, 2)
  currency String  @default("INR") @db.VarChar(3)

  // Razorpay identifiers
  providerOrderId       String? @unique @db.VarChar(100)
  providerPaymentId     String? @unique @db.VarChar(100)
  providerPaymentLinkId String? @unique @db.VarChar(100)

  // Prevent duplicate payment creation from repeated requests.
  idempotencyKey String @unique @db.VarChar(150)

  failureReason String? @db.Text
  metadata      Json?

  initiatedAt DateTime  @default(now()) @db.Timestamptz(3)
  capturedAt  DateTime? @db.Timestamptz(3)
  refundedAt  DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  businessUser User    @relation("PaymentBusiness", fields: [businessUserId], references: [id], onDelete: Restrict)
  clientUser   User?   @relation("PaymentClient", fields: [clientUserId], references: [id], onDelete: Restrict)

  @@index([invoiceId, status])
  @@index([businessUserId, status, createdAt])
  @@index([clientUserId, status])
  @@map("payments")
}

// -----------------------------------------------------
// PAYMENT WEBHOOK EVENTS
// -----------------------------------------------------

model PaymentWebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  provider        PaymentProvider
  providerEventId String          @db.VarChar(150)

  eventType String @db.VarChar(150)

  // Store the received event for verification and auditing.
  payload Json

  signatureVerified Boolean                 @default(false)
  status            WebhookProcessingStatus @default(RECEIVED)

  receivedAt  DateTime  @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)

  errorMessage String? @db.Text

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@map("payment_webhook_events")
}

// -----------------------------------------------------
// NOTIFICATIONS
// -----------------------------------------------------

model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  type  NotificationType
  title String           @db.VarChar(200)
  body  String           @db.Text

  data   Json?
  readAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// -----------------------------------------------------
// AUDIT LOGS
// -----------------------------------------------------

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  // Nullable only to accommodate legacy/ownerless records.
  // Normal application queries MUST exclude records
  // where ownerUserId is null.
  ownerUserId String? @db.Uuid

  actorUserId String? @db.Uuid

  action     String  @db.VarChar(100)
  entityType String  @db.VarChar(100)
  entityId   String? @db.VarChar(100)

  details Json?

  ipAddress String? @db.VarChar(50)
  userAgent String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  ownerUser User? @relation("AuditOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  actorUser User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
