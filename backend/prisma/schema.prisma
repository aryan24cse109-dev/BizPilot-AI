generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  FINANCE_MANAGER
  MEMBER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  PAYPAL
  MANUAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum MessageSenderType {
  USER
  SYSTEM
}

enum NotificationType {
  INVOICE_SENT
  INVOICE_VIEWED
  INVOICE_PAID
  INVOICE_OVERDUE
  PAYMENT_RECEIVED
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  SYSTEM_ALERT
}

// 1. User Account
model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String?
  name          String
  username      String         @unique
  accountStatus AccountStatus  @default(ACTIVE)
  isEmailVerified Boolean      @default(true)
  googleId      String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relationships
  profile             UserProfile?
  workspacesOwned     BusinessWorkspace[] @relation("WorkspaceOwner")
  workspaceMembers    WorkspaceMember[]
  sentConnections     Connection[]        @relation("SentConnections")
  receivedConnections Connection[]        @relation("ReceivedConnections")
  clientInvoices      Invoice[]           @relation("ClientInvoices")
  clientPayments      Payment[]           @relation("ClientPayments")
  messagesSent        Message[]           @relation("UserSentMessages")
  notifications       Notification[]
  aiConversations     AIConversation[]
  auditLogs           AuditLog[]
  conversationsAsUser1 Conversation[]     @relation("ConversationUser1")
  conversationsAsUser2 Conversation[]     @relation("ConversationUser2")

  @@index([email])
  @@index([username])
}

// 2. User Profile
model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  phone       String?
  avatarUrl   String?
  preferredLang String @default("en") // en, hi, hinglish
  theme       String   @default("dark") // light, dark
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 3. Business Workspace
model BusinessWorkspace {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  ownerId     String
  isActive    Boolean  @default(true)
  currency    String   @default("INR") // Default currency
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner            User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  businessProfile  BusinessProfile?
  members          WorkspaceMember[]
  invoices         Invoice[]
  invoiceSequences InvoiceSequence[]
  paymentAccounts  PaymentAccount[]
  payments         Payment[]
  reminderSchedules ReminderSchedule[]
  aiConversations  AIConversation[]
  aiActionLogs     AIActionLog[]
  auditLogs        AuditLog[]
  webhookEvents    WebhookEvent[]

  @@index([ownerId])
  @@index([slug])
}

// 4. Workspace Member (Roles & Permissions)
model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

// 5. Business Profile
model BusinessProfile {
  id             String   @id @default(uuid())
  workspaceId    String   @unique
  businessName   String
  legalName      String?
  businessType   String?  // Freelancer, Agency, Startup, Small Business
  logoUrl        String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String   @default("India")
  taxId          String?  // GSTIN / PAN / VAT
  email          String?
  phone          String?
  website        String?
  paymentInstructions String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// 6. Connection (Business <-> Client network)
model Connection {
  id          String           @id @default(uuid())
  senderId    String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  sender   User @relation("SentConnections", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

// 7. Invoice
model Invoice {
  id                String        @id @default(uuid())
  workspaceId       String
  invoiceNumber     String        // Sequenced e.g. INV-2026-0001
  clientId          String        // User receiving the invoice
  status            InvoiceStatus @default(DRAFT)
  issueDate         DateTime      @default(now())
  dueDate           DateTime
  currency          String        @default("INR")
  subtotal          Decimal       @db.Decimal(12, 2)
  taxRate           Decimal       @default(0.0) @db.Decimal(5, 2) // % tax rate e.g. 18.00
  taxAmount         Decimal       @default(0.0) @db.Decimal(12, 2)
  discountRate      Decimal       @default(0.0) @db.Decimal(5, 2) // % discount
  discountAmount    Decimal       @default(0.0) @db.Decimal(12, 2)
  totalAmount       Decimal       @db.Decimal(12, 2)
  paidAmount        Decimal       @default(0.0) @db.Decimal(12, 2)
  balanceDue        Decimal       @db.Decimal(12, 2)
  notes             String?
  terms             String?
  paymentLink       String?
  isArchived        Boolean       @default(false)
  sentAt            DateTime?
  viewedAt          DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  workspace       BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  client          User              @relation("ClientInvoices", fields: [clientId], references: [id], onDelete: Restrict)
  items           InvoiceItem[]
  events          InvoiceEvent[]
  payments        Payment[]
  paymentAttempts PaymentAttempt[]
  reminderSchedules ReminderSchedule[]

  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId])
  @@index([clientId])
  @@index([status])
  @@index([dueDate])
}

// 8. Invoice Item (Line Items)
model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Decimal  @default(1.0) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// 9. Invoice Event (Audit lifecycle)
model InvoiceEvent {
  id          String   @id @default(uuid())
  invoiceId   String
  eventType   String   // CREATED, SENT, VIEWED, PAYMENT_RECEIVED, CANCELLED, REMINDER_SENT
  description String
  metadata    Json?
  actorId     String?
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([createdAt])
}

// 10. Invoice Sequence (Unique, gapless numbering per workspace)
model InvoiceSequence {
  id          String   @id @default(uuid())
  workspaceId String
  year        Int
  prefix      String   @default("INV")
  currentSeq  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, year, prefix])
}

// 11. Payment Account (Connected Razorpay/PayPal merchant credentials)
model PaymentAccount {
  id          String          @id @default(uuid())
  workspaceId String
  provider    PaymentProvider
  accountId   String?         // Razorpay Key ID or PayPal Client ID
  keySecret   String?         // Encrypted Key Secret
  webhookSecret String?
  isActive    Boolean         @default(true)
  isSandbox   Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

// 12. Payment (Authoritative completed/verified payments)
model Payment {
  id               String          @id @default(uuid())
  workspaceId      String
  invoiceId        String
  clientId         String
  paymentAccountId String?
  amount           Decimal         @db.Decimal(12, 2)
  currency         String          @default("INR")
  status           PaymentStatus   @default(SUCCEEDED)
  provider         PaymentProvider
  providerPaymentId String         @unique // e.g. pay_xxxxx from Razorpay or capture id from PayPal
  providerOrderId  String?         // order_xxxxx
  paymentMethod    String?         // UPI, CARD, NETBANKING, PAYPAL
  paymentDate      DateTime        @default(now())
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  workspace      BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  invoice        Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  client         User              @relation("ClientPayments", fields: [clientId], references: [id], onDelete: Restrict)
  paymentAccount PaymentAccount?   @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  refunds        Refund[]

  @@index([workspaceId])
  @@index([invoiceId])
  @@index([clientId])
  @@index([paymentDate])
  @@index([status])
}

// 13. Payment Attempt (Tracks order creation prior to confirmation)
model PaymentAttempt {
  id               String          @id @default(uuid())
  invoiceId        String
  provider         PaymentProvider
  providerOrderId  String          @unique
  amount           Decimal         @db.Decimal(12, 2)
  currency         String          @default("INR")
  status           PaymentStatus   @default(PENDING)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([providerOrderId])
}

// 14. Webhook Event (Idempotent tracking of incoming payment callbacks)
model WebhookEvent {
  id            String        @id @default(uuid())
  workspaceId   String?
  provider      PaymentProvider
  eventId       String        @unique // Provider's event ID
  eventType     String
  payload       Json
  status        WebhookStatus @default(RECEIVED)
  errorMessage  String?
  processedAt   DateTime?
  createdAt     DateTime      @default(now())

  workspace BusinessWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([provider, eventId])
  @@index([status])
}

// 15. Refund
model Refund {
  id              String        @id @default(uuid())
  paymentId       String
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("INR")
  providerRefundId String       @unique
  reason          String?
  status          PaymentStatus @default(SUCCEEDED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

// 16. Conversation (Messaging between connected users)
model Conversation {
  id         String   @id @default(uuid())
  user1Id    String
  user2Id    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user1    User      @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2    User      @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

// 17. Message
model Message {
  id             String            @id @default(uuid())
  conversationId String
  senderId       String?           // Nullable if system generated
  senderType     MessageSenderType @default(USER)
  content        String
  isRead         Boolean           @default(false)
  activityType   String?           // INVOICE_CREATED, INVOICE_SENT, PAYMENT_RECEIVED, etc.
  activityData   Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation("UserSentMessages", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([createdAt])
}

// 18. Notification
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  linkUrl   String?
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

// 19. Reminder Schedule
model ReminderSchedule {
  id          String   @id @default(uuid())
  workspaceId String
  invoiceId   String
  scheduledFor DateTime
  isSent      Boolean  @default(false)
  sentAt      DateTime?
  message     String?
  createdAt   DateTime @default(now())

  workspace BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([scheduledFor, isSent])
}

// 20. AI Conversation
model AIConversation {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String?
  title       String   @default("Business Assistant Session")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   BusinessWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    AIMessage[]
  actionLogs  AIActionLog[]

  @@index([userId])
  @@index([workspaceId])
}

// 21. AI Message
model AIMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String   // user, assistant, system, tool
  content        String
  intent         String?  // CREATE_INVOICE, GET_INVOICES, etc.
  toolCalls      Json?    // Structured tool invocations
  toolResult     Json?
  audioUrl       String?  // Voice recording if voice input
  transcript     String?  // STT output
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

// 22. AI Action Log (Audit log of actions proposed and confirmed by user)
model AIActionLog {
  id             String   @id @default(uuid())
  conversationId String
  workspaceId    String
  intent         String
  parameters     Json
  isConfirmed    Boolean  @default(false)
  executedAt     DateTime?
  executionResult Json?
  createdAt      DateTime @default(now())

  conversation AIConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace    BusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([workspaceId])
}

// 23. Audit Log (System-wide security and operations trail)
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  workspaceId String?
  action      String   // LOGIN, LOGOUT, INVOICE_CREATED, PAYMENT_VERIFIED, etc.
  entityType  String   // Invoice, Payment, Workspace, User
  entityId    String?
  ipAddress   String?
  userAgent   String?
  details     Json?
  createdAt   DateTime @default(now())

  user      User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace BusinessWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([action])
  @@index([createdAt])
}
