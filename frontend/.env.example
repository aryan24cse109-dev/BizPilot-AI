# ========================================================
# Wealthra™ Frontend Environment Configuration Example
# All rights to this project are owned by DEVRATOR.
# ========================================================

# Base API URL for Backend Services (leave /api to use Vite reverse proxy in development)
VITE_API_BASE_URL=/api

# Application Branding
VITE_APP_NAME="Wealthra™"
VITE_APP_TAGLINE="Financial Operations & Invoicing Platform"

# Google OAuth 2.0 Client ID (for Google Sign-In & Registration)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Razorpay Sandbox Public Key ID (for client-side payments & checkout)
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# AI & Voice Capabilities
VITE_ENABLE_AI_VOICE=true

